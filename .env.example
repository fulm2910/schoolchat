# Copy to .env and adjust. Real environment variables take precedence over this file.

# Port the HTTP server listens on. Most hosts set this for you.
PORT=3000

# How long a login lasts, in days.
SESSION_DAYS=30

# Optional. When set, new accounts need this code to sign up. Leave empty for open signup.
INVITE_CODE=

# --- Optional extras -------------------------------------------------------

# Where the SQLite file lives. On a host, point this at the persistent disk, e.g. /data/chat.db
# DB_PATH=./data/chat.db

# Set to 1 when running behind one reverse proxy (Render, Fly.io, nginx) so client IPs
# for rate limiting and HTTPS detection for Secure cookies come from X-Forwarded-* headers.
# Leave unset when the app is exposed directly, or clients could spoof their IP.
# TRUST_PROXY=1

# Set to 0 to turn off the per-request access log (method, path, status, time).
# LOG_REQUESTS=1
